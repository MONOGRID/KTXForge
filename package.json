{
  "name": "ktxforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "check": "npm run check:rust && npm run check:web && npm run check:fallow",
    "check:fallow": "fallow dead-code --fail-on-issues && fallow dupes --threshold 3 && fallow health --min-score 85 --min-severity high",
    "precheck:rust": "npm run ensure-tools && npm run fetch-ktx",
    "check:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && cargo machete --with-metadata src-tauri",
    "check:web": "npm run build && npm run lint && npm run lint:style",
    "dev": "vite",
    "ensure-tools": "node scripts/ensure-tools.mjs",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --format json --quiet",
    "fetch-ktx": "node scripts/fetch-ktx.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint src",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\"",
    "prepare": "husky",
    "preview": "vite preview",
    "release": "semantic-release",
    "release-outputs": "node scripts/release-outputs.mjs",
    "set-version": "node scripts/set-version.mjs",
    "setup": "npm run ensure-tools && npm run fetch-ktx",
    "pretauri": "npm run fetch-ktx",
    "tauri": "tauri",
    "tauri:build:signed": "node scripts/with-updater-signing-key.mjs npm run tauri -- build",
    "with-signing-key": "node scripts/with-updater-signing-key.mjs",
    "test:image-cache-lru": "node scripts/image-cache-lru-selftest.mjs",
    "test:menu-shortcuts": "node scripts/menu-shortcuts-selftest.mjs",
    "test:scrub-gate": "node scripts/scrub-gate-selftest.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@unocss/reset": "^66.10.5",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fallow": "^3.33.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "sass": "^1.105.1",
    "semantic-release": "^25.0.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "unocss": "^66.10.5",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-shadcn": "^1.0.1",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.12"
  }
}
