{
  "name": "ktxforge",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "check": "npm run check:rust && npm run check:web && npm run check:fallow",
    "check:fallow": "fallow dead-code --fail-on-issues && fallow dupes --threshold 3 && fallow health --min-score 85 --min-severity high",
    "precheck:rust": "npm run ensure-tools && npm run fetch-ktx",
    "check:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && cargo machete --with-metadata src-tauri",
    "check:web": "npm run build && npm run typecheck:e2e && npm run lint && npm run lint:style && npm run test",
    "dev": "vite",
    "pree2e": "npm run fetch-ktx",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "ensure-tools": "node scripts/ensure-tools.mjs",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --format json --quiet",
    "fetch-ktx": "node scripts/fetch-ktx.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint src e2e",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\"",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "prepare": "node scripts/prepare-git.mjs",
    "preview": "vite preview",
    "release": "semantic-release",
    "release-outputs": "node scripts/release-outputs.mjs",
    "set-version": "node scripts/set-version.mjs",
    "setup": "npm run ensure-tools && npm run fetch-ktx",
    "pretauri": "npm run fetch-ktx",
    "tauri": "tauri",
    "tauri:build:signed": "node scripts/with-updater-signing-key.mjs npm run tauri -- build",
    "test": "vitest run",
    "test:watch": "vitest",
    "with-signing-key": "node scripts/with-updater-signing-key.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.56.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@unocss/reset": "^66.11.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fallow": "^3.33.1",
    "globals": "^17.13.0",
    "sass": "^1.105.1",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "unocss": "^66.11.0",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-shadcn": "^1.0.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
