{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main (encoder) window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "window-state:default",
    "dialog:allow-message",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
