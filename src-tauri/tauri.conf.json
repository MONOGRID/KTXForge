{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KTXForge",
  "version": "../package.json",
  "identifier": "com.monogrid.ktxforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KTXForge",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ktx", "binaries/ktx2ktx2"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ktx2"],
        "name": "KTX2 Texture",
        "description": "Khronos KTX2 Texture",
        "mimeType": "image/ktx2",
        "role": "Viewer",
        "rank": "Default",
        "exportedType": {
          "identifier": "com.monogrid.ktxforge.ktx2",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["ktx"],
        "name": "KTX Texture",
        "description": "Khronos KTX Texture",
        "mimeType": "image/ktx",
        "role": "Viewer",
        "rank": "Default",
        "exportedType": {
          "identifier": "com.monogrid.ktxforge.ktx",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDNjgwNEI4REExNUEwMjYKUldRbW9CWGF1QVJvbkdiV3N2VjFKalpFUFlOREdXS21WNGhtNmJFbVlWcFhjZ25PM3hKQ3RQMU8K",
      "endpoints": [
        "https://github.com/MONOGRID/KTXForge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
